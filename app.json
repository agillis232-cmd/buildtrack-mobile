{
  "expo": {
    "name": "BuildTrack",
    "slug": "buildtrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1F26"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.watthouse.buildtrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1F26"
      },
      "package": "com.watthouse.buildtrack"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "BuildTrack needs access to your photos to upload site photos and receipts.",
          "cameraPermission": "BuildTrack needs access to your camera to capture site photos and receipts."
        }
      ]
    ],
    "scheme": "buildtrack",
    "experiments": {
      "typedRoutes": true
    }
  }
}